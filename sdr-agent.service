[Unit]
Description=SDR Agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sdr-agent
ExecStart=/usr/bin/python3 -m uvicorn agent.main:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5

# Optional: set a shared secret
# Environment=SDR_API_KEY=changeme
# Environment=SDR_UNIT_ID=unit-1

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
